# @meddleware/seal-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle.

# Network: testnet (default) or mainnet
VITE_NETWORK=testnet

# Sui RPC URL overrides (sensible defaults are built in — only set to use a private node)
# VITE_RPC_TESTNET=https://fullnode.testnet.sui.io:443
# VITE_RPC_MAINNET=https://fullnode.mainnet.sui.io:443

# ── Seal committee ──────────────────────────────────────────────────────────
# Meddleware's canonical seal_policies package (deployed 2026-09-02):
VITE_SEAL_PACKAGE_ID_TESTNET=0x9f0563bfe42fbd29932cd280cc47efe17f5339b4dc569eb110114665eecc231e
# VITE_SEAL_PACKAGE_ID_MAINNET=   # populate on mainnet deploy

# Key-server committee: CSV of object ids and their aggregator URLs (index-aligned).
# Obtain from https://seal-docs.wal.app/ → testnet key server list.
# Example (replace with the actual IDs from the Seal docs):
# VITE_SEAL_SERVER_OBJECT_IDS_TESTNET=0x<server1_id>,0x<server2_id>,0x<server3_id>
# VITE_SEAL_AGGREGATOR_URLS_TESTNET=https://ks-1.testnet.seal.sui.io,https://ks-2.testnet.seal.sui.io,https://ks-3.testnet.seal.sui.io
VITE_SEAL_SERVER_OBJECT_IDS_TESTNET=
VITE_SEAL_AGGREGATOR_URLS_TESTNET=

# Threshold t in t-of-n (default 2 → any 2 of 3 servers can decrypt)
VITE_SEAL_THRESHOLD=2

# ── Walrus storage ──────────────────────────────────────────────────────────
# HTTP publisher/aggregator for ciphertext blobs.
# Defaults to the public Walrus testnet endpoints — override to use the Meddleware relay.
# VITE_WALRUS_PUBLISHER_TESTNET=https://sui-walrus.meddleware.co.uk/relay
# VITE_WALRUS_AGGREGATOR_TESTNET=https://aggregator.walrus-testnet.walrus.space
VITE_WALRUS_EPOCHS=5
