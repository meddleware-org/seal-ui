# @meddleware/seal-ui — build-time environment
# Copy to .env.local for local dev (never commit .env.local).
# In production these are Docker --build-arg values baked into the static bundle.

# Network: testnet (default) or mainnet
VITE_NETWORK=testnet

# Sui RPC URL overrides (sensible defaults are built in — only set to use a private node)
# VITE_RPC_TESTNET=https://fullnode.testnet.sui.io:443
# VITE_RPC_MAINNET=https://fullnode.mainnet.sui.io:443

# ── Seal committee ──────────────────────────────────────────────────────────
# Meddleware's canonical seal_policies package (the built-in default; links access_gate 0x1a81ca…):
VITE_SEAL_PACKAGE_ID_TESTNET=0x42cc181f851ef702c1fddc9b925553f03b71784edff49d80fbc260055f86d612
# VITE_SEAL_PACKAGE_ID_MAINNET=   # populate on mainnet deploy

# Key servers: CSV of object ids and index-aligned aggregator URLs (an aggregator URL only for a
# committee; independent servers publish their URL on-chain). Defaults are Mysten's verified
# servers: testnet = the committee + two independent servers; mainnet = the 5-of-8 committee
# behind https://seal-aggregator-mainnet.mystenlabs.com. Leave unset to use them.
# VITE_SEAL_SERVER_OBJECT_IDS_TESTNET=0x<committee>,0x<server2>,0x<server3>
# VITE_SEAL_AGGREGATOR_URLS_TESTNET=https://seal-aggregator-testnet.mystenlabs.com
# VITE_SEAL_SERVER_OBJECT_IDS_MAINNET=
# VITE_SEAL_AGGREGATOR_URLS_MAINNET=

# Enoki API key sent as X-API-Key to aggregator-backed servers. Required by the mainnet
# aggregator. It is baked into the public bundle, so use a key scoped to Seal only.
# VITE_SEAL_AGGREGATOR_API_KEY_MAINNET=

# Threshold over the configured servers; a committee counts as ONE server.
# Defaults: testnet 2, mainnet 1. Values outside [1, number of servers] fail at startup.
# VITE_SEAL_THRESHOLD=2

# ── Walrus storage ──────────────────────────────────────────────────────────
# HTTP publisher (store) and aggregator (read) for ciphertext blobs. Testnet defaults to the
# public Mysten endpoints; mainnet has NO public publisher — set an operator-run one.
# VITE_WALRUS_PUBLISHER_TESTNET=https://publisher.walrus-testnet.walrus.space
# VITE_WALRUS_PUBLISHER_MAINNET=
# VITE_WALRUS_AGGREGATOR_TESTNET=https://aggregator.walrus-testnet.walrus.space
# VITE_WALRUS_AGGREGATOR_MAINNET=https://aggregator.walrus-mainnet.walrus.space
VITE_WALRUS_EPOCHS=5
# Largest ciphertext sent to the publisher (public publishers accept 10 MiB).
# VITE_WALRUS_MAX_UPLOAD_BYTES=10485760

# ── Docs ────────────────────────────────────────────────────────────────────
# Documentation URL — override to link to a custom or staging docs deployment.
# VITE_DOCS_URL=https://docs.meddleware.co.uk/blockchain/sui/sealed-storage/

# Developer docs URL — override to link to a custom or staging dev-docs deployment.
# VITE_DEV_URL=https://dev.meddleware.co.uk/sui/sealed-storage/
